# Ollama server (defaults are fine for a local install)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=8192

# Storage paths
CHROMA_DIR=data/chroma
UPLOAD_DIR=data/uploads
DOCUMENT_REGISTRY=data/documents.json

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Retrieval
RETRIEVER_K=4
